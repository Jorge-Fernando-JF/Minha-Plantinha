# Copie para .env (ou rode "npm run setup" em desenvolvimento). NUNCA coloque valores reais aqui.
NODE_ENV=production
PORT=3000
PUBLIC_BASE_URL=https://seu-dominio.exemplo
TRUST_PROXY=1

# Segredos do servidor (>= 32 caracteres aleatórios; gere com: openssl rand -hex 32)
SESSION_SECRET=
HASH_PEPPER=

# E-mail para confirmação do responsável (obrigatório para cadastrar menores em produção)
SMTP_URL=
SMTP_FROM=

# Conta administrativa: só é criada se ADMIN_SEED_ENABLED=true e ainda não existir.
# Em produção exige senha >= 12 e código >= 8 caracteres definidos pelo responsável.
ADMIN_SEED_ENABLED=false
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_ACCESS_CODE=
ADMIN_NICK=Administrador
